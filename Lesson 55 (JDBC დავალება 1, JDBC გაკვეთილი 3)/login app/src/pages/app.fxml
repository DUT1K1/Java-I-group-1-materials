<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AppController">
   <children>
      <Label layoutX="240.0" layoutY="32.0" text="Register">
         <font>
            <Font size="35.0" />
         </font>
      </Label>
      <TextField fx:id="firstNameField" layoutX="220.0" layoutY="121.0" promptText="ex. Davit" />
      <TextField fx:id="lastNameField" layoutX="220.0" layoutY="160.0" promptText="ex. Maisuradze" />
      <TextField fx:id="emailField" layoutX="220.0" layoutY="200.0" promptText="ex. davit@example.com" />
      <Button layoutX="248.0" layoutY="296.0" mnemonicParsing="false" onAction="#register" prefHeight="37.0" prefWidth="106.0" text="Sign Up" />
      <Label layoutX="151.0" layoutY="126.0" text="First name:" />
      <Label layoutX="151.0" layoutY="165.0" text="Last name:" />
      <Label layoutX="175.0" layoutY="205.0" text="Email:" />
      <Label layoutX="154.0" layoutY="247.0" text="Password" />
      <PasswordField fx:id="passwordField" layoutX="220.0" layoutY="243.0" promptText="ex. Strong@Pass123" />
   </children>
</AnchorPane>
