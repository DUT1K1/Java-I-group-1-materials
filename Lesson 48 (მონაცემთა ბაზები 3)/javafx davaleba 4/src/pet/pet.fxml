<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pet.PetController">
   <children>
      <RadioButton fx:id="cat" layoutX="35.0" layoutY="165.0" mnemonicParsing="false" text="კატა">
         <toggleGroup>
            <ToggleGroup fx:id="pet" />
         </toggleGroup>
      </RadioButton>
      <RadioButton layoutX="171.0" layoutY="165.0" mnemonicParsing="false" text="ძაღლი" toggleGroup="$pet" />
      <RadioButton layoutX="330.0" layoutY="165.0" mnemonicParsing="false" text="კურდღელი" toggleGroup="$pet" />
      <RadioButton layoutX="491.0" layoutY="165.0" mnemonicParsing="false" text="ჩიტი" toggleGroup="$pet" />
      <TextField fx:id="textfield" layoutX="220.0" layoutY="233.0" />
      <Button layoutX="272.0" layoutY="303.0" mnemonicParsing="false" onAction="#pick" text="submit" />
      <Label fx:id="label" alignment="CENTER" layoutX="49.0" layoutY="35.0" prefHeight="46.0" prefWidth="501.0" textAlignment="CENTER">
         <font>
            <Font size="22.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
